    "@aws-sdk/util-dynamodb": "^3.996.2",
    "arraybuffer-to-string": "^1.0.2",
    "async": "^3.2.4",
    "axios": "^1.16.0",
    "boolean": "^3.1.4",
    "bullmq": "^5.76.6",
    "colors": "1.4.0",
    "commander": "^14.0.3",
    "dot-wild": "^3.0.1",
    "dotenv": "^17.4.2",
