    "aws-sdk": "^2.1426.0",
    "axios": "^1.16.0",
    "boolean": "^3.1.4",
    "bullmq": "^1.80.3",
    "colors": "1.4.0",
    "dot-wild": "^3.0.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.0.4",
    "knex": "^3.0.1",
    "mysql": "^2.18.1",
    "mysql2": "^3.22.3",
    "nats": "^2.7.1",
    "node-discover": "^1.2.1",
    "pg": "^8.7.1",
    "pm2": "^7.0.1",
    "prom-client": "^15.1.3",
    "prometheus-query": "^3.5.1",
    "pusher": "^5.1.0-beta",
    "query-string": "^7.1.0",
    "rate-limiter-flexible": "^2.3.8",
    "sqs-consumer": "^5.7.0",
    "uuid": "^8.3.2",
