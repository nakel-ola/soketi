{
  "name": "@soketi/soketi",
  "version": "0.0.0-dev",
  "description": "Just another simple, fast, and resilient open-source WebSockets server.",
  "repository": {
    "type": "git",
    "url": "https://github.com/soketi/soketi.git"
  },
  "main": "dist/index.js",
